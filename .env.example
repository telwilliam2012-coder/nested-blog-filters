# Local development. Shopify CLI supplies the public app URL and credentials.
DATABASE_URL="file:dev.sqlite"
SHOPIFY_APP_URL=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=write_products,read_products,read_content,write_content,write_app_proxy
SHOPIFY_APP_HANDLE=nested-blog-filters-search
SHOPIFY_BILLING_MODE=managed
