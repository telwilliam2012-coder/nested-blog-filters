{% liquid
  assign page_size = block.settings.page_size | default: 12
  assign proxy_path = block.settings.proxy_path | default: '/apps/nested-filters' | remove_first: '/'
%}

{% style %}
  #nested-blog-filters-{{ block.id }} {
    {% if block.settings.badge_bg_color != blank %}
      --nbf-badge-bg: {{ block.settings.badge_bg_color }};
    {% endif %}
    {% if block.settings.badge_text_color != blank %}
      --nbf-badge-text: {{ block.settings.badge_text_color }};
    {% endif %}
    {% if block.settings.accent_color != blank %}
      --nbf-accent: {{ block.settings.accent_color }};
    {% endif %}
    {% if block.settings.text_color != blank %}
      --nbf-text: {{ block.settings.text_color }};
    {% endif %}
    {% if block.settings.muted_text_color != blank %}
      --nbf-muted-text: {{ block.settings.muted_text_color }};
    {% endif %}
    {% if block.settings.surface_color != blank %}
      --nbf-surface-bg: {{ block.settings.surface_color }};
    {% endif %}
    {% if block.settings.soft_bg_color != blank %}
      --nbf-soft-bg: {{ block.settings.soft_bg_color }};
    {% endif %}
    {% if block.settings.border_color != blank %}
      --nbf-border-color: {{ block.settings.border_color }};
    {% endif %}
    {% if block.settings.search_bg_color != blank %}
      --nbf-search-bg: {{ block.settings.search_bg_color }};
    {% endif %}
    {% if block.settings.search_button_bg_color != blank %}
      --nbf-search-button-bg: {{ block.settings.search_button_bg_color }};
    {% endif %}
    {% if block.settings.search_button_text_color != blank %}
      --nbf-search-button-text: {{ block.settings.search_button_text_color }};
    {% endif %}
    {% if block.settings.selected_bg_color != blank %}
      --nbf-selected-bg: {{ block.settings.selected_bg_color }};
    {% endif %}
    {% if block.settings.selected_text_color != blank %}
      --nbf-selected-text: {{ block.settings.selected_text_color }};
    {% endif %}
    {% if block.settings.chip_bg_color != blank %}
      --nbf-chip-bg: {{ block.settings.chip_bg_color }};
    {% endif %}
    {% if block.settings.chip_text_color != blank %}
      --nbf-chip-text: {{ block.settings.chip_text_color }};
    {% endif %}
  }
{% endstyle %}

{% if blog != blank %}
  <nested-blog-filters
    id="nested-blog-filters-{{ block.id }}"
    class="nbf"
    data-blog-id="gid://shopify/Blog/{{ blog.id }}"
    data-blog-url="{{ blog.url | escape }}"
    data-proxy-url="{{ routes.root_url | append: proxy_path | escape }}"
    data-page-size="{{ page_size }}"
    data-locale="{{ request.locale.iso_code | escape }}"
    data-design-mode="{{ request.design_mode }}"
    data-loading="{{ 'filters.loading' | t | escape }}"
    data-error="{{ 'filters.error' | t | escape }}"
    data-empty="{{ 'filters.empty' | t | escape }}"
    data-unconfigured="{{ 'filters.unconfigured' | t | escape }}"
    data-results-label="{{ 'filters.results' | t: count: '[count]' | escape }}"
    data-page-label="{{ 'filters.page' | t: current: '[current]', total: '[total]' | escape }}"
    data-read-label="{{ 'filters.read' | t | escape }}"
    data-choose-label="{{ 'filters.choose' | t | escape }}"
    data-remove-label="{{ 'filters.remove' | t: value: '[value]' | escape }}"
    data-empty-title="{{ 'filters.empty_title' | t | escape }}"
    {{ block.shopify_attributes }}
  >
    <h2 class="nbf__sr-only">{{ 'filters.heading' | t }}</h2>
    <div class="nbf__search-bar">
      <form class="nbf__search" action="{{ routes.search_url }}" method="get" role="search" aria-label="{{ 'filters.search_label' | t | escape }}" data-search-form>
        <svg class="nbf__search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/></svg>
        <input type="hidden" name="type" value="article">
        <label class="nbf__sr-only" for="nbf-search-{{ block.id }}">{{ 'filters.search_label' | t }}</label>
        <input id="nbf-search-{{ block.id }}" type="search" name="q" maxlength="200" placeholder="{{ 'filters.search_placeholder' | t | escape }}" data-search-input>
        <button class="nbf__search-submit" type="submit">
          {{ 'filters.search_submit' | t }}
        </button>
      </form>
    </div>
    <section class="nbf__toolbar" data-toolbar aria-label="{{ 'filters.panel_title' | t | escape }}" hidden>
      <div class="nbf__filter-row">
        <div class="nbf__filters" data-filters></div>
        <button class="nbf__clear" type="button" data-clear disabled>{{ 'filters.clear' | t }}</button>
      </div>
      <div class="nbf__active" data-active aria-label="{{ 'filters.active' | t | escape }}" hidden></div>
    </section>
    <p class="nbf__status" data-status role="status" aria-live="polite" aria-atomic="true"></p>
    <button class="nbf__button" type="button" data-retry hidden>{{ 'filters.retry' | t }}</button>
    <div data-results-container aria-busy="false">
      <ul class="nbf__articles" data-results>
        {% for article in blog.articles limit: page_size %}
          <li class="nbf__card">
            {% if article.image %}
              <a href="{{ article.url | escape }}">{{ article.image | image_url: width: 600 | image_tag: class: 'nbf__image', loading: 'lazy', widths: '240, 400, 600', sizes: '(max-width: 480px) 100vw, (max-width: 750px) 50vw, 25vw' }}</a>
            {% endif %}
            <div class="nbf__card-body">
              <h3><a href="{{ article.url | escape }}">{{ article.title | escape }}</a></h3>
              <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: format: 'abbreviated_date' }}</time>
              <a class="nbf__read" href="{{ article.url | escape }}">{{ 'filters.read' | t }}<span class="nbf__sr-only">: {{ article.title | escape }}</span></a>
            </div>
          </li>
        {% endfor %}
      </ul>
    </div>
    <nav class="nbf__pagination" aria-label="{{ 'filters.pagination' | t | escape }}" data-pagination hidden>
      <button class="nbf__button" type="button" data-previous>{{ 'filters.previous' | t }}</button>
      <span data-page></span>
      <button class="nbf__button" type="button" data-next>{{ 'filters.next' | t }}</button>
    </nav>
    <p class="nbf__fallback" data-blog-link><a href="{{ blog.url | escape }}">{{ 'filters.view_blog' | t }}</a></p>
    <noscript><p>{{ 'filters.no_script' | t }}</p></noscript>
  </nested-blog-filters>
  <script src="{{ 'analytics.js' | asset_url }}" defer></script>
{% elsif request.design_mode %}
  <p {{ block.shopify_attributes }}>{{ 'filters.choose_blog' | t }}</p>
{% endif %}

{% schema %}
{
  "name": "t:filters.name",
  "target": "content",
  "enabled_on": { "templates": ["blog"] },
  "javascript": "filters.js",
  "stylesheet": "filters.css",
  "settings": [
    {
      "type": "select",
      "id": "page_size",
      "label": "t:filters.page_size",
      "options": [
        { "value": "6", "label": "6" },
        { "value": "12", "label": "12" },
        { "value": "24", "label": "24" },
        { "value": "48", "label": "48" }
      ],
      "default": "12"
    },
    {
      "type": "header",
      "content": "t:filters.colors_general"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "t:filters.accent_color",
      "default": "#245c4c"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:filters.text_color",
      "default": "#20332e"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "t:filters.muted_text_color",
      "info": "t:filters.muted_text_info",
      "default": "#65756f"
    },
    {
      "type": "color",
      "id": "surface_color",
      "label": "t:filters.surface_color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "soft_bg_color",
      "label": "t:filters.soft_bg_color",
      "default": "#f3f7f5"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:filters.border_color",
      "default": "#dce5e0"
    },
    {
      "type": "paragraph",
      "content": "t:filters.colors_inheritance"
    },
    {
      "type": "header",
      "content": "t:filters.colors_search"
    },
    {
      "type": "color",
      "id": "search_bg_color",
      "label": "t:filters.search_bg_color"
    },
    {
      "type": "color",
      "id": "search_button_bg_color",
      "label": "t:filters.search_button_bg_color"
    },
    {
      "type": "color",
      "id": "search_button_text_color",
      "label": "t:filters.search_button_text_color"
    },
    {
      "type": "header",
      "content": "t:filters.colors_selection"
    },
    {
      "type": "color",
      "id": "selected_bg_color",
      "label": "t:filters.selected_bg_color"
    },
    {
      "type": "color",
      "id": "selected_text_color",
      "label": "t:filters.selected_text_color"
    },
    {
      "type": "color",
      "id": "chip_bg_color",
      "label": "t:filters.chip_bg_color"
    },
    {
      "type": "color",
      "id": "chip_text_color",
      "label": "t:filters.chip_text_color"
    },
    {
      "type": "header",
      "content": "t:filters.colors_badges"
    },
    {
      "type": "color",
      "id": "badge_bg_color",
      "label": "t:filters.badge_bg_color",
      "default": "#0e5a44"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "t:filters.badge_text_color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "proxy_path",
      "label": "t:filters.proxy_path",
      "info": "t:filters.proxy_info",
      "default": "/apps/nested-filters"
    }
  ]
}
{% endschema %}
