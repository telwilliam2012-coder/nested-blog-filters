# Set these in the cloud provider, never commit real credentials.
NODE_ENV=production
# Paste the stable HTTPS URL assigned to the web service, without a path.
SHOPIFY_APP_URL=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=write_products,read_products,read_content,write_content,write_app_proxy
# Render PostgreSQL: paste the private DATABASE_URL only in Render.
# Build with Dockerfile.postgresql; see docs/deployment-postgresql.md.
DATABASE_URL=
HOST=0.0.0.0
PORT=3000
SHOPIFY_APP_HANDLE=nested-blog-filters
SHOPIFY_BILLING_MODE=managed
SHOPIFY_BILLING_TEST=false
PRIVACY_POLICY_URL=
TOS_URL=

# Production managed pricing. Configure these secrets only in Render.
SHOPIFY_PARTNER_ID=
SHOPIFY_PARTNER_API_ACCESS_TOKEN=
